      "checkConstraints": {
        "foods_source_check": {
          "name": "foods_source_check",
          "value": "\"foods\".\"source\" in ('custom', 'off', 'nevo')"
        },
        "foods_name_length": {
          "name": "foods_name_length",
          "value": "char_length(\"foods\".\"name\") between 1 and 100"
